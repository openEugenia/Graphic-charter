{
  "name": "@openeugenia/graphic-charter-remotion",
  "private": true,
  "description": "Posters and videos in the openEugenia graphic charter, rendered with Remotion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "charter": "npm --prefix .. run build:css",
    "studio": "npm run charter && remotion studio",
    "still": "npm run charter && remotion still",
    "render": "npm run charter && remotion render",
    "logo:svg": "node scripts/export-logo.mjs",
    "site": "remotion bundle --out-dir ../_site/studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
